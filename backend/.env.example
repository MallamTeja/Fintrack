# Copy to backend/.env for local development. Never commit .env files.
# Local Supabase (`npx supabase start`) prints these values; in production Vercel's Supabase integration sets them.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon / publishable key>
PORT=5000
# Optional: extra origins allowed to call the API cross-origin (comma separated)
FRONTEND_URL=
